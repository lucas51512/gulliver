// Basic Quantum Programming Examples in Gulliver Language (.gl)
// Demonstrates fundamental quantum concepts: superposition and entanglement

def main() -> void {
    // Example 1: Single Qubit Superposition
    def createSuperposition(qubit: int) -> int {
        // Apply Hadamard gate to create equal superposition |0⟩ + |1⟩
        return had(qubit);
    }

    // Example 2: Two Qubit Bell State (Entanglement)
    def createBellState(qubit1: int, qubit2: int) -> int[] {
        let q1: int = had(qubit1);  // Put first qubit in superposition
        let q2: int = cnot(q1, qubit2);  // Entangle with CNOT gate
        return [q1, q2];
    }

    // Example 3: Quantum Phase Flip
    def phaseFlip(qubit: int) -> int {
        return z(qubit);  // Apply Z gate for phase flip
    }

    // Example 4: Quantum Measurement with multiple qubits
    def measureAll(qubits: int[]) -> int[] {
        let results: int[3];
        for (let i: int = 0; i < size(qubits); i = i + 1) {
            results[i] = measure(qubits[i]);
        }
        return results;
    }

    // Demo execution
    print("=== Basic Quantum Computing Demo ===");
    
    // Initialize qubits in |0⟩ state
    let q0: int = 0;
    let q1: int = 0;
    let q2: int = 0;

    print("1. Creating superposition on qubit 0...");
    q0 = createSuperposition(q0);
    
    print("2. Creating Bell state with qubits 1 and 2...");
    let bellPair: int[] = createBellState(q1, q2);
    q1 = bellPair[0];
    q2 = bellPair[1];

    print("3. Applying phase flip to qubit 0...");
    q0 = phaseFlip(q0);

    print("4. Measuring all qubits...");
    let allQubits: int[3] = [q0, q1, q2];
    let measurements: int[] = measureAll(allQubits);
    
    print("Measurement results:");
    print("Qubit 0: ", measurements[0]);
    print("Qubit 1: ", measurements[1]);
    print("Qubit 2: ", measurements[2]);
    
    print("=== Demo Complete ===");
}